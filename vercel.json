{
  "framework": "vite",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/work", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    {
      "source": "/project/library/full/:bookSlug",
      "destination": "/api/book-preview?bookSlug=:bookSlug"
    },
    {
      "source": "/library/:bookSlug",
      "destination": "/api/book-preview?bookSlug=:bookSlug"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}




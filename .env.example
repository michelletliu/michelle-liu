# Sanity write token for book suggestions (server-side only).
# Get this from: https://www.sanity.io/manage/project/am3v0x1c/api#tokens
# Create a token with "Editor" permissions.
SANITY_WRITE_TOKEN=your_token_here

# Per-project passwords for protected case study sections.
# Format: PASSWORD_<COMPANY>=<password>
# The company name must match the project's "company" field in Sanity (uppercased).
PASSWORD_ADOBE=
PASSWORD_ROBLOX=

# Secret used to sign HttpOnly unlock cookies after a password succeeds.
# Required in production. Generate with: openssl rand -base64 32
PASSWORD_SESSION_SECRET=

# Optional read token for server-side project fetches. Required if protected
# project content is moved behind private Sanity access.
SANITY_READ_TOKEN=

# PostHog analytics (client-side).
# Get key/project from https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to US cloud host.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Reve image generation for /gallery (server only — never NEXT_PUBLIC_).
# Create a token in the Reve API console.
REVE_API_TOKEN=

# Vercel Blob read/write token for gallery Save & Share (server only).
# Create a Blob store in the Vercel dashboard and copy the token, or run
# `vercel env pull`. Required for POST/GET /api/gallery/share*.
BLOB_READ_WRITE_TOKEN=

# Optional. HMAC key for shareId-bound gallery edit tokens. When unset, derived
# from BLOB_READ_WRITE_TOKEN. Set explicitly if you ever rotate the Blob token
# and still need older session edit tokens to verify via edit.json only.
# GALLERY_EDIT_HMAC_SECRET=

# Optional. Pin hang image URLs to this public Blob host
# (`{storeId}.public.blob.vercel-storage.com`). When unset, the host is
# derived from `BLOB_READ_WRITE_TOKEN` (`vercel_blob_rw_{storeId}_…`).
BLOB_PUBLIC_HOST=

# Sanity write token for book suggestions
# Get this from: https://www.sanity.io/manage/project/am3v0x1c/api#tokens
# Create a token with "Editor" permissions
VITE_SANITY_WRITE_TOKEN=your_token_here

# Server-side password map for protected sections (kept out of Sanity).
# Format: {"<projectId-or-company>:<sectionKey>":"<password>"}
# Example: {"nasa:abc123":"adastra1234"}
PROTECTED_SECTION_PASSWORDS_JSON={}

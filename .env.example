# Sanity write token for book suggestions (server-side only).
# Get this from: https://www.sanity.io/manage/project/am3v0x1c/api#tokens
# Create a token with "Editor" permissions.
SANITY_WRITE_TOKEN=your_token_here

# Per-project passwords for protected case study sections.
# Format: PASSWORD_<COMPANY>=<password>
# The company name must match the project's "company" field in Sanity (uppercased).
PASSWORD_NASA=
PASSWORD_ADOBE=
PASSWORD_ROBLOX=

# PostHog analytics (client-side).
# Get key/project from https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to US cloud host.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# TMDb API key for movie poster script (scripts/update-movie-posters.js).
# Get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Spotify credentials for URL fixer script (scripts/fix-spotify-urls.js).
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
